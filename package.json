{
  "name": "@ericjuta/omp-cljs-codemode",
  "version": "0.1.20",
  "description": "Add Squint ClojureScript cells to OMP's native codemode eval tool.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericjuta/omp-cljs-codemode.git"
  },
  "private": true,
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "eval:guidance": "bun scripts/eval-guidance.ts",
    "test": "bun test"
  },
  "dependencies": {
    "squint-cljs": "0.8.159"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "typebox": "1.3.10",
    "typescript": "5.8.3"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  }
}
